<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SegundaTelaActivity">

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calcular"
        tools:layout_editor_absoluteX="253dp"
        tools:layout_editor_absoluteY="607dp" />

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"
        tools:layout_editor_absoluteX="81dp"
        tools:layout_editor_absoluteY="609dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="175dp"
        tools:layout_editor_absoluteY="74dp" />

    <CheckBox
        android:id="@+id/cbTransporte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transporte"
        tools:layout_editor_absoluteX="70dp"
        tools:layout_editor_absoluteY="290dp" />

    <CheckBox
        android:id="@+id/cbAlimentacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alimentação"
        tools:layout_editor_absoluteX="73dp"
        tools:layout_editor_absoluteY="377dp" />

    <CheckBox
        android:id="@+id/cbPasseio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Passeios"
        tools:layout_editor_absoluteX="72dp"
        tools:layout_editor_absoluteY="475dp" />

</androidx.constraintlayout.widget.ConstraintLayout>